# 生产环境变量模板 —— 部署到服务器时拷贝为 .env 再填值
# compose 启动时读 PORT / LOG_LEVEL / DATABASE_SSL / JWT_SECRET
# (DATABASE_URL 由 compose 写死指向容器内 postgres)

NODE_ENV=production

# 服务端口(对外暴露用,与 docker-compose ports 左侧一致)
# 服务器上 tasks-api 占着 9999,这里必须换,例如 4000
PORT=9999

# pino 日志等级:fatal|error|warn|info|debug|trace
# 生产默认 info;排查时改 debug
LOG_LEVEL=info

# PostgreSQL 连接串
# - 跟 compose 一起用:留空即可,compose 内置为 postgresql://postgres:postgres@postgres:5432/hlse
# - 单独跑容器/连外部托管 PG:写完整 URL,例如
#     postgresql://user:pass@host:5432/hlse
#     postgresql://user:pass@ep-xxx.region.aws.neon.tech/hlse?sslmode=require
DATABASE_URL=

# 是否启用 SSL/TLS 加密通道
# - 本地 / 同机 docker:false
# - 托管 PG(Neon/Supabase/RDS/阿里云):true
DATABASE_SSL=false

# 本服务 PG 容器映射到宿主机的端口(只影响宿主机能不能直连容器内的 PG)
# 本地默认 5433;服务器上 tasks-api 的 PG 已占 5433,这里改成 5434
# 容器内的 app 走 docker 内置 DNS 直连 postgres:5432,不经过这个端口
PG_HOST_PORT=5433

# OpenAPI 文档的路径前缀
# - 生产挂在 nginx /api-hls 反代后:OPENAPI_BASE_PATH=/api-hls(Scalar 的 curl/Try it out 会自动拼前缀)
# - 本机直连(无反代):留空即可
# 注意:compose 里是 ${OPENAPI_BASE_PATH:-/api},留空则回落到默认值 /api
OPENAPI_BASE_PATH=

# 注意:DATABASE_SSL 是字符串,不是 boolean
#       z.coerce.boolean() 会把 'false' 转成 true(JS 经典坑),所以这里用 enum 严格解析
#       docker-compose 里的 ${DATABASE_SSL:-false} 也会传字符串 'false',已被正确处理

# === 鉴权 ===
# JWT 签名密钥,至少 16 个字符。
# 旧 Nest 项目里硬编码成了 'YOUR_SECRET_KEY_KEEP_IT_SAFE',任何人都能伪造登录态,
# 这里必须换成随机强密钥。生成方式:
#     openssl rand -base64 32
# 泄露后果:任何人都能伪造任意用户的登录 Cookie。
# 换密钥后所有人被登出(旧 Cookie 全部失效),属正常现象。
JWT_SECRET=

# 登录态 Cookie 名 —— 保持默认值 Authentication。
# 前端 hlsEdu/web-front 的 axios 依赖这个 HttpOnly Cookie,改名会导致登不上。
AUTH_COOKIE_NAME=Authentication

# 登录态有效期(秒),默认 1 天
AUTH_COOKIE_MAX_AGE=86400