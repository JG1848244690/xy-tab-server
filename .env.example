# 生产环境变量模板 —— 部署到服务器时拷贝为 .env 再填值
# compose 启动时只会读这些 PORT/LOG_LEVEL/DATABASE_SSL(DATABASE_URL 由 compose 写死指向容器内 postgres)
# 如单独 docker run 不用 compose,需要补 DATABASE_URL

NODE_ENV=production

# 服务端口(对外暴露用,与 docker-compose ports 左侧一致)
PORT=9999

# pino 日志等级:fatal|error|warn|info|debug|trace
# 生产默认 info;排查时改 debug
LOG_LEVEL=info

# PostgreSQL 连接串
# - 跟 compose 一起用:留空即可,compose 内置为 postgresql://postgres:postgres@postgres:5432/tasks
# - 单独跑容器/连外部托管 PG:写完整 URL,例如
#     postgresql://user:pass@host:5432/db
#     postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# 是否启用 SSL/TLS 加密通道
# - 本地 / 同机 docker:false
# - 托管 PG(Neon/Supabase/RDS/阿里云):true
DATABASE_SSL=false

# OpenAPI 文档的路径前缀
# - 生产挂在 nginx /api 反代后:OPENAPI_BASE_PATH=/api(Scalar 的 curl/Try it out 会自动拼前缀)
# - 本机直连(无反代):留空即可
# 注意:compose 启动时此值由 docker-compose.yml 写死为 /api,这里仅供单独 docker run 参考
OPENAPI_BASE_PATH=

# 注意:DATABASE_SSL 是字符串,不是 boolean
#       z.coerce.boolean() 会把 'false' 转成 true(JS 经典坑),所以这里用 enum 严格解析
#       docker-compose 里的 ${DATABASE_SSL:-false} 也会传字符串 'false',已被正确处理

# === 云同步(Google OAuth)===
# 在 Google Cloud Console → API 和服务 → 凭据 创建 OAuth 2.0 客户端 ID
# 类型: Web 应用
# 已授权的重定向 URI: https://<EXTENSION_ID>.chromiumapp.org/
# ⚠️ Client Secret 极度敏感,绝不能提交到 git / 写到前端 / 出现在聊天中
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 允许的 redirect_uri 正则(防有人拿别的 code 骗后端换 token)
# 默认 ^https://[a-z]+\.chromiumapp\.org/$ 已能覆盖所有 Chrome 扩展
GOOGLE_ALLOWED_REDIRECT_REGEX=^https://[a-z]+\.chromiumapp\.org/$
