# 生产环境变量模板 —— 部署到服务器时拷贝为 .env 再填值
# compose 启动时只会读这些 PORT/LOG_LEVEL/DATABASE_SSL(DATABASE_URL 由 compose 写死指向容器内 postgres)
# 如单独 docker run 不用 compose,需要补 DATABASE_URL

NODE_ENV=production

# 服务端口(对外暴露用,与 docker-compose ports 左侧一致)
PORT=9999

# pino 日志等级:fatal|error|warn|info|debug|trace
# 生产默认 info;排查时改 debug
LOG_LEVEL=info

# PostgreSQL 连接串
# - 跟 compose 一起用:留空即可,compose 内置为 postgresql://postgres:postgres@postgres:5432/tasks
# - 单独跑容器/连外部托管 PG:写完整 URL,例如
#     postgresql://user:pass@host:5432/db
#     postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# 是否启用 SSL/TLS 加密通道
# - 本地 / 同机 docker:false
# - 托管 PG(Neon/Supabase/RDS/阿里云):true
DATABASE_SSL=false

# 注意:DATABASE_SSL 是字符串,不是 boolean
#       z.coerce.boolean() 会把 'false' 转成 true(JS 经典坑),所以这里用 enum 严格解析
#       docker-compose 里的 ${DATABASE_SSL:-false} 也会传字符串 'false',已被正确处理