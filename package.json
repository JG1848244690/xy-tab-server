{
    "name": "xy-tab-server",
    "private": true,
    "description": "HLS 学习平台 monorepo:apps/api(Hono 后端)、apps/web(后台 SPA)、未来的 apps/site(面试站)",
    "packageManager": "pnpm@10.23.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev:api": "pnpm --filter hlse-api dev",
        "dev:web": "pnpm --filter web-front dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm --filter hlse-api test --run"
    }
}
